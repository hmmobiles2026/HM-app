generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── Auth ────────────────────────────────────────────────────────────────────

enum Role {
  ADMIN
  OWNER
  SELLER
}

model User {
  id             String   @id @default(cuid())
  name           String
  username       String   @unique
  password       String
  role           Role     @default(SELLER)
  whatsappNumber String?
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  sales            Sale[]
  stockMovements   StockMovement[]
  refreshTokens    RefreshToken[]
  telegramSessions TelegramSession[]
  ledgerEntries    CustomerLedger[]
}

model RefreshToken {
  id        String   @id @default(cuid())
  token     String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

// ─── Suppliers ───────────────────────────────────────────────────────────────

model Supplier {
  id        String   @id @default(cuid())
  name      String   @unique
  phone     String?
  note      String?
  createdAt DateTime @default(now())

  products       Product[]
  returns        SaleReturn[]
  stockMovements StockMovement[]
}

// ─── Product Catalog ─────────────────────────────────────────────────────────

model Category {
  id        String   @id @default(cuid())
  name      String   @unique
  createdAt DateTime @default(now())

  products   Product[]
  partBrands PartBrand[]
}

model PartBrand {
  id         String    @id @default(cuid())
  name       String
  category   Category  @relation(fields: [categoryId], references: [id])
  categoryId String
  deletedAt  DateTime?
  createdAt  DateTime  @default(now())

  products Product[]

  @@index([categoryId, name])
}

model Brand {
  id        String    @id @default(cuid())
  name      String
  deletedAt DateTime?
  createdAt DateTime  @default(now())

  models   PhoneModel[]
  products Product[]

  @@index([name])
}

model PhoneModel {
  id        String    @id @default(cuid())
  name      String
  brand     Brand     @relation(fields: [brandId], references: [id], onDelete: Cascade)
  brandId   String
  deletedAt DateTime?
  createdAt DateTime  @default(now())

  products Product[]

  @@index([brandId, name])
}

enum QualityGrade {
  ORIGINAL
  COPY_A
  COPY_B
  OTHER
}

model Product {
  id              String       @id @default(cuid())
  name            String
  description     String?
  tags            String[]
  imageUrl        String?
  imagePublicId   String?
  category        Category     @relation(fields: [categoryId], references: [id])
  categoryId      String
  partBrand       PartBrand?   @relation(fields: [partBrandId], references: [id])
  partBrandId     String?
  brand           Brand        @relation(fields: [brandId], references: [id])
  brandId         String
  model           PhoneModel?  @relation(fields: [modelId], references: [id])
  modelId         String?
  supplier        Supplier?    @relation(fields: [supplierId], references: [id])
  supplierId      String?
  qualityGrade    QualityGrade @default(ORIGINAL)
  costPrice       Decimal      @db.Decimal(10, 2)
  sellingPrice    Decimal      @db.Decimal(10, 2)
  stockQty        Int          @default(0)
  lowStockThreshold Int        @default(5)
  isActive        Boolean      @default(true)
  deletedAt       DateTime?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  stockMovements StockMovement[]
  saleItems      SaleItem[]
  priceHistory   PriceHistory[]
}

model PriceHistory {
  id           String   @id @default(cuid())
  product      Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId    String
  oldCostPrice Decimal  @db.Decimal(10, 2)
  newCostPrice Decimal  @db.Decimal(10, 2)
  oldSellPrice Decimal  @db.Decimal(10, 2)
  newSellPrice Decimal  @db.Decimal(10, 2)
  changedAt    DateTime @default(now())

  @@index([productId])
}

// ─── Stock Movements ─────────────────────────────────────────────────────────

enum MovementType {
  IN
  OUT
  ADJUSTMENT
  RETURN
}

model StockMovement {
  id         String       @id @default(cuid())
  product    Product      @relation(fields: [productId], references: [id])
  productId  String
  type       MovementType
  quantity   Int
  note       String?
  supplier   Supplier?    @relation(fields: [supplierId], references: [id])
  supplierId String?
  createdBy  User         @relation(fields: [userId], references: [id])
  userId     String
  createdAt  DateTime     @default(now())
}

// ─── Customers (Credit / Accounts Receivable) ────────────────────────────────

// Customers are other mobile phone shops that buy on credit and settle over time.
// Their outstanding balance is NEVER stored as a column — it is always derived from
// CustomerLedger so it cannot drift out of sync. See src/lib/customers.ts.
model Customer {
  id          String    @id @default(cuid())
  // Unique, matching Supplier.name. Two records for the same shop would split that
  // shop's debt across both and the real total would be invisible. If two genuinely
  // different shops share a name, distinguish them ("City Cell - Kandy").
  shopName    String    @unique
  ownerName   String?
  phone       String?
  address     String?
  creditLimit Decimal?  @db.Decimal(10, 2)
  note        String?
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  sales  Sale[]
  ledger CustomerLedger[]

  // No @@index([shopName]) — @unique already creates one.
  @@index([isActive])
}

enum LedgerType {
  CHARGE // credit sale — increases what they owe
  PAYMENT // money received — decreases
  RETURN_CREDIT // goods returned — decreases
  ADJUSTMENT // manual owner correction; amount is SIGNED
}

enum PaymentMethod {
  CASH
  BANK
  CHEQUE
  OTHER
}

// One row per money event against a customer. Append-only in spirit: corrections are
// made with an ADJUSTMENT row, not by editing history. The only deletion case is
// cancelSupplierReturn, which must remove the RETURN_CREDIT row it created.
model CustomerLedger {
  id         String         @id @default(cuid())
  customer   Customer       @relation(fields: [customerId], references: [id])
  customerId String
  type       LedgerType
  // Always positive EXCEPT for ADJUSTMENT, where a negative value reduces the debt.
  amount     Decimal        @db.Decimal(10, 2)
  // saleId and returnId are deliberately plain columns, NOT foreign keys.
  // cancelSupplierReturn() deletes its SaleReturn row outright. A real relation would
  // either block that delete (RESTRICT) or silently drop the ledger row (CASCADE) —
  // and silently dropping it would leave the customer credited for a return that no
  // longer exists. Reversing it must be an explicit, visible step in the action.
  saleId     String?
  returnId   String?
  method     PaymentMethod?
  note       String?
  createdBy  User           @relation(fields: [userId], references: [id])
  userId     String
  createdAt  DateTime       @default(now())

  @@index([customerId, createdAt])
  @@index([saleId])
  @@index([returnId])
  // Serves the "payments collected this month" dashboard aggregate.
  @@index([type, createdAt])
}

// ─── Sales ───────────────────────────────────────────────────────────────────

model Sale {
  id           String   @id @default(cuid())
  seller       User     @relation(fields: [sellerId], references: [id])
  sellerId     String
  // Nullable forever. null = walk-in cash sale, which is every sale made before the
  // credit feature existed. Making this required would break every historical row.
  customer     Customer? @relation(fields: [customerId], references: [id])
  customerId   String?
  totalRevenue Decimal  @db.Decimal(10, 2)
  totalCost    Decimal  @db.Decimal(10, 2)
  profit       Decimal  @db.Decimal(10, 2)
  warrantyFee  Decimal? @db.Decimal(10, 2)
  note         String?
  createdAt    DateTime @default(now())

  items SaleItem[]

  @@index([customerId])
}

model SaleItem {
  id        String  @id @default(cuid())
  sale      Sale    @relation(fields: [saleId], references: [id], onDelete: Cascade)
  saleId    String
  product   Product @relation(fields: [productId], references: [id])
  productId String
  quantity  Int
  unitPrice Decimal @db.Decimal(10, 2)
  unitCost  Decimal @db.Decimal(10, 2)

  returns   SaleReturn[]

  @@index([saleId])
}

enum ReturnType {
  STOCK_BACK
  SUPPLIER_RETURN
}

enum SupplierReturnStatus {
  PENDING
  RESOLVED
}

model SaleReturn {
  id             String                @id @default(cuid())
  saleItem       SaleItem              @relation(fields: [saleItemId], references: [id], onDelete: Cascade)
  saleItemId     String
  quantity       Int
  reason         String
  refundAmount   Decimal               @db.Decimal(10, 2)
  returnType     ReturnType            @default(STOCK_BACK)
  supplier       Supplier?             @relation(fields: [supplierId], references: [id])
  supplierId     String?
  costRecovery   Decimal?              @db.Decimal(10, 2)
  supplierStatus SupplierReturnStatus?
  resolvedAt     DateTime?
  createdAt      DateTime              @default(now())

  @@index([saleItemId])
  @@index([supplierId])
}

// ─── Licensing ───────────────────────────────────────────────────────────────

model AppLicense {
  id               String    @id @default(cuid())
  installedAt      DateTime  @default(now())
  trialStartedAt   DateTime?
  licensedUntil    DateTime?
  forceDeactivated Boolean   @default(false)
  updatedAt        DateTime  @updatedAt
}

// ─── WhatsApp ─────────────────────────────────────────────────────────────────

model WhatsAppConfig {
  id              String   @id @default(cuid())
  phoneNumberId   String
  accessToken     String
  webhookSecret   String
  recipientNumber String
  devNumber       String?
  isActive        Boolean  @default(true)
  updatedAt       DateTime @updatedAt
}

model WhatsAppLog {
  id        String   @id @default(cuid())
  direction String
  from      String
  to        String
  message   String   @db.Text
  createdAt DateTime @default(now())
}

// ─── Telegram ─────────────────────────────────────────────────────────────────

model TelegramConfig {
  id            String   @id @default(cuid())
  botToken      String
  chatId        String
  webhookSecret String
  isActive      Boolean  @default(true)
  updatedAt     DateTime @updatedAt
}

model TelegramLog {
  id        String   @id @default(cuid())
  direction String
  from      String
  to        String
  message   String   @db.Text
  createdAt DateTime @default(now())
}

model TelegramSession {
  id        String   @id @default(cuid())
  chatId    String   @unique
  userId    String
  role      String
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([chatId])
}
